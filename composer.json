{
    "name": "sumberproteinjogja/landing-page",
    "type": "project",
    "description": "Landing Page E-Commerce Bahan Makanan Mentah & Frozen Sumber Protein Jogja",
    "keywords": ["laravel", "ecommerce", "frozen-food", "sumber-protein-jogja", "blade", "tailwind"],
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "laravel/framework": "^11.0|^12.0|^13.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump"
        ]
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
